# Copy to .env.local and fill in. Never commit .env.local.

# Local Postgres database (createdb brim_ap). scripts/reset-db.sh uses its name.
DATABASE_URL=postgresql://localhost/brim_ap

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me

# Your Anthropic API key: with it, emails, PDFs and scans are read by Claude. Restart the server after setting it.
# Without a key, run the stand-in reader (npx tsx scripts/reader.ts) and also set ANTHROPIC_BASE_URL=http://localhost:4545,
# with any value here; it answers only for the dataset's own documents.
ANTHROPIC_API_KEY=

# The dataset, loaded into the database by scripts/ingest.ts; another folder in the same format can take its place.
# Relative paths resolve against the repo root.
DATASET_DIR=./brim_ap_dataset

# The feeds the app reads: the AP mailbox export, incoming invoices, card transactions and FX rates.
FEEDS_DIR=./brim_ap_dataset

# Where uploaded and polled attachments are stored. Relative paths resolve against the repo root.
STORAGE_DIR=./storage

# The bank's folder: payment instructions go to outbox/, statements and card charges come back (scripts/bank.ts).
BANK_DIR=./storage/bank

# Password of every demo account; clicking an account on a login page signs in with it.
DEMO_PASSWORD=

# The app's "today" is the as-of date in the dataset's README; set AS_OF_DATE=YYYY-MM-DD only to use another.

# The organization's own GST/HST number, printed as "bill to" on its invoices but not in the dataset. When set, an invoice
# billed to another number is flagged; leave empty for a dataset whose number you don't know.
ORG_GST_HST_NUMBER=100000001RT0001

# Port the Express server listens on.
PORT=3000

# Where scripts/ingest.ts reaches the running server.
BASE_URL=http://localhost:3000
